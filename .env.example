# ===== FIFA FLAG QUIZ — environment =====
# Copy to .env and adjust.

# Backend
FIFAQUIZ_DB_PATH=./data/fifa_quiz.db
FIFAQUIZ_DEFAULT_LANGUAGE=it
FIFAQUIZ_DEBUG=false
FIFAQUIZ_ADMIN_ENABLED=true
FIFAQUIZ_ADMIN_TOKEN=change-me

# Data update layer
FIFAQUIZ_DATA_CACHE_DIR=./data/cache
FIFAQUIZ_DATA_BASELINE_DIR=./data/baseline
FIFAQUIZ_UPDATE_TIMEOUT_SECONDS=30
FIFAQUIZ_EXPECTED_ASSOCIATIONS=211

# Quiz engine (configurable weights, section 15)
FIFAQUIZ_SIM_WEIGHT_COLOR=0.30
FIFAQUIZ_SIM_WEIGHT_COLOR_COUNT=0.20
FIFAQUIZ_SIM_WEIGHT_STRUCTURE=0.15
FIFAQUIZ_SIM_WEIGHT_GEOMETRY=0.15
FIFAQUIZ_SIM_WEIGHT_SYMBOL=0.10
FIFAQUIZ_SIM_WEIGHT_ORIENTATION=0.10

# Security / rate limiting
FIFAQUIZ_RATE_LIMIT_PER_MINUTE=60

# Frontend (Vite dev proxy target)
VITE_API_URL=http://localhost:8000
